# PostgreSQL/PostGIS connection used by the web app (read-mostly) and ingestion
DATABASE_URL=postgresql://atlas:atlas_dev@127.0.0.1:5432/atlas
# Shared secret for /admin and /api/admin/* (set a long random value in production)
ADMIN_TOKEN=change-me
# Set to "true" ONLY after a licence review of The Crown Estate GIS licence (restricts onward supply for commercial gain)
TCE_EXPORT_REVIEWED=false
# Optional: path to ogr2ogr for GeoPackage export
OGR2OGR_PATH=
NEXT_PUBLIC_SITE_NAME=GB Renewable Energy Atlas

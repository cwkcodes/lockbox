# ---- docker compose (see docs/DEPLOYMENT.md) ----
POSTGRES_PASSWORD=change-me-too
# Shared secret for /admin and /api/admin/*. The app refuses to enable admin in production while this is empty or "change-me".
ADMIN_TOKEN=
# An address publishers can contact you on; sent in the User-Agent of every download.
ATLAS_CONTACT=
# Set to "true" ONLY after a licence review of The Crown Estate's GIS licence (it restricts onward supply for commercial gain).
TCE_EXPORT_REVIEWED=false

# ---- optional: only if you are permitted to use them ----
# Comma-separated hosts whose robots.txt you have the publisher's permission to override. Every snapshot fetched this way is
# annotated in raw.snapshot.notes. Leave empty to keep full robots.txt compliance (the default).
ATLAS_ROBOTS_OVERRIDE=
# An Overpass API endpoint you are allowed to use (the public instances throttle and may be blocked). Empty = OSM adapter reports source_unavailable.
OVERPASS_URL=
# Opendatasoft API keys issued to you by the DNOs (their anonymous record APIs answer ForbiddenAccess).
ODS_API_KEY_UKPN=
ODS_API_KEY_ENWL=
ODS_API_KEY_SPEN=
